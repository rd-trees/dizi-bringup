# Recents -> app with SurfaceFlinger's per-frame layer state (composition type, transform, corner radius,
# crop, alpha), the frame timeline and gfx/wm atrace. Works on user builds.
buffers { size_kb: 262144 fill_policy: RING_BUFFER }
buffers { size_kb: 8192 fill_policy: RING_BUFFER }
data_sources { config { name: "android.surfaceflinger.frametimeline" } }
data_sources { config { name: "android.surfaceflinger.layers" surfaceflinger_layers_config { mode: MODE_ACTIVE trace_flags: TRACE_FLAG_COMPOSITION } } }
data_sources { config { name: "linux.process_stats" process_stats_config { scan_all_processes_on_start: true } } }
data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      ftrace_events: "sched/sched_switch"
      ftrace_events: "power/gpu_frequency"
      atrace_categories: "gfx"
      atrace_categories: "wm"
      atrace_apps: "*"
      buffer_size_kb: 65536
    }
  }
}
data_sources { config { name: "android.log" target_buffer: 1 android_log_config { log_ids: LID_DEFAULT } } }
duration_ms: 60000
