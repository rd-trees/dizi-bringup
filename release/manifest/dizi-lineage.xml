<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for building LineageOS 23.2 (Android 16) with built-in GApps (MindTheGapps)
  for the Redmi Pad Pro (dizi).
  Put it in .repo/local_manifests/ after `repo init -u https://github.com/LineageOS/android.git -b lineage-23.2 --git-lfs`,
  then `repo sync`, apply device/xiaomi/dizi/patches (build/make, frameworks/native, vendor/lineage,
  packages/apps/Launcher3), then:
    source build/envsetup.sh && lunch lineage_dizi-bp4a-user && m bacon
  Drop the vendor/gapps project for a build without GApps.
-->
<manifest>
  <remote name="dizi" fetch="https://github.com/rd-trees" />
  <remote name="evo-devices" fetch="https://github.com/Evolution-X-Devices" />
  <remote name="github-non-los" fetch="https://github.com" />
  <remote name="mtg" fetch="https://github.com/MindTheGapps" />

  <!-- Device (branch lineage-23.2: bka-dizi + Trebuchet visual effects, MindTheGapps, compat fixes) -->
  <project path="device/xiaomi/dizi" name="device_xiaomi_dizi" remote="dizi" revision="lineage-23.2" />
  <project path="device/xiaomi/dizi-kernel" name="device_xiaomi_dizi-kernel" remote="dizi" revision="bka" />
  <project path="vendor/xiaomi/dizi" name="vendor_xiaomi_dizi" remote="dizi" revision="lineage-23.2" />

  <!-- Kernel headers and the device-side repos EvoX uses (same commits as bka) -->
  <project path="kernel/xiaomi/sm7435" name="kernel_xiaomi_garnet" remote="evo-devices" revision="bka" clone-depth="1" />
  <project path="kernel/xiaomi/sm7435-modules" name="kernel_xiaomi_garnet-modules" remote="evo-devices" revision="bka" clone-depth="1" />
  <project path="hardware/xiaomi" name="Evolution-X-Devices/hardware_xiaomi" remote="github-non-los" revision="bka-no-dolby" />
  <project path="hardware/dolby" name="Evolution-X-Devices/hardware_dolby" remote="github-non-los" revision="bka-aospa" />
  <project path="packages/apps/GameBar" name="packages_apps_GameBar" remote="evo-devices" revision="bka" />

  <!-- GApps built in -->
  <project path="vendor/gapps" name="vendor_gapps" remote="mtg" revision="baklava" />
</manifest>
